{{- $home := .chezmoi.homeDir -}}
{{- $candidates := list -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $candidates = list (joinPath $home "Library/Application Support/zen") -}}
{{- else if eq .chezmoi.os "linux" -}}
{{-   $xdg := env "XDG_CONFIG_HOME" | default (joinPath $home ".config") -}}
{{-   $candidates = list (joinPath $xdg "zen") (joinPath $home ".zen") (joinPath $home ".var/app/app.zen_browser.zen/.zen") -}}
{{- end -}}
{{- $zenDir := "" -}}
{{- range $candidates -}}
{{-   if and (not $zenDir) (stat (joinPath . "installs.ini")) -}}
{{-     $zenDir = . -}}
{{-   end -}}
{{- end -}}
{{- if $zenDir -}}
#!/usr/bin/env bash
# user.js hash: {{ include "dot_config/zen/user.js" | sha256sum }}

set -eufo pipefail

zen_dir={{ $zenDir | quote }}
src={{ joinPath .chezmoi.sourceDir "dot_config/zen/user.js" | quote }}
host_prefs='{{ if eq .chezmoi.hostname "main" }}user_pref("layout.frame_rate", 240);{{ end }}'

# Install-default profiles (Firefox 67+ semantics)
while IFS= read -r profile; do
  target="$zen_dir/$profile"
  [[ -d "$target" ]] || continue

  tmp=$(mktemp "$target/.user.js.XXXXXX")
  cp "$src" "$tmp"
  if [[ -n "$host_prefs" ]]; then
    printf '\n// Host\n%s\n' "$host_prefs" >>"$tmp"
  fi
  mv -f "$tmp" "$target/user.js"
  echo "[user.js] updated $profile"
done < <(sed -n 's/^Default=//p' "$zen_dir/installs.ini")
{{ end -}}
