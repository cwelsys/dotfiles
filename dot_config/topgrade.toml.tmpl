[misc]
disable = [
	"containers",
	"pip3",
	"pnpm",
  "node",
	"yarn",
	"uv",
	"shell",
  "waydroid",
  "gcloud",
  "colima",
  "dotnet",
  "firmware",
  "android_studio",
  "nix"
]

first = ["chezmoi"]
# last = ["system"]
# ignore_failures = ["powershell"]

{{- $fleet := dict -}}{{- if hasKey . "hosts" -}}{{- $fleet = .hosts -}}{{- end -}}
{{- $chain := list -}}
{{- range $n, $h := $fleet -}}
{{-   if and (ne $n $.hostname) (has (get $h "chassis") (list "desktop" "server")) -}}
{{-     $chain = append $chain $n -}}
{{-   end -}}
{{- end }}
remote_topgrades = {{ $chain | toJson }}

remote_topgrade_path = "'topgrade --disable remotes'"
# ssh_arguments = "-o ConnectTimeout=2"
assume_yes = true
# cleanup = true
notify_end = "never"
no_self_update = true

[pre_commands]
{{ if lookPath "kernl" }}
#Kernel = "kernl"
{{ end }}
[post_commands]

[commands]
"zinit" = "-i zinit self-update && zinit update --parallel 40; exit $?"
{{ if eq .hostname "main" }}
"GE-Proton" = "fetch-eggroll"
{{ end }}

[brew]
autoremove = true

[linux]
arch_package_manager = "paru"
