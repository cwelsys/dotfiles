#!/usr/bin/env bash

PIDFILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/screensaver.pid"

signal_runner() { # $1 = signal name
  [[ -r "$PIDFILE" ]] || return 0
  local pid
  pid=$(<"$PIDFILE")
  [[ "$pid" =~ ^[0-9]+$ ]] && kill -"$1" "$pid" 2>/dev/null
}

case "$1" in
onRequestMonitorOff)
  signal_runner USR1
  exit 0
  ;;
onRequestMonitorOn)
  signal_runner USR2
  exit 0
  ;;
esac

if [[ "$1" == "--run" ]]; then
  echo $$ >"$PIDFILE"
  tte_pid= # empty = paused

  start_tte() {
    tte -i ~/Pictures/screensaver.txt \
      --frame-rate 60 \
      --canvas-width 0 --canvas-height 0 \
      --reuse-canvas --anchor-canvas c --anchor-text c \
      --random-effect --exclude-effects matrix synthgrid sweep \
      --no-eol --no-restore-cursor &
    tte_pid=$!
  }

  stop_tte() {
    [[ -n "$tte_pid" ]] && kill "$tte_pid" 2>/dev/null
    tte_pid=
    printf '\e[2J\e[H' # clear to black while paused
  }

  cleanup() {
    stop_tte
    rm -f "$PIDFILE"
    stty echo 2>/dev/null
    printf '\e[?1003l' # disable mouse reporting
    exit 0
  }

  trap cleanup INT TERM HUP
  trap '[[ -n "$tte_pid" ]] && stop_tte' USR1  # monitor off -> pause
  trap '[[ -z "$tte_pid" ]] && start_tte' USR2 # monitor on  -> resume

  stty -echo 2>/dev/null
  printf '\e[?1003h' # report mouse movement so motion also dismisses

  start_tte
  while true; do
    # any keypress or mouse movement dismisses the screensaver
    read -rt 0.2 -n 1 -s && cleanup
    # restart with a fresh effect when the current one finishes (while animating)
    [[ -n "$tte_pid" ]] && ! kill -0 "$tte_pid" 2>/dev/null && start_tte
  done
fi

command -v tte &>/dev/null || exit 1
pgrep -f "app-id=screensaver" >/dev/null && exit 0

exec kitten panel \
  --edge=center \
  --layer=overlay \
  --focus-policy=exclusive \
  --grab-keyboard \
  --exclusive-zone=-1 \
  --app-id=screensaver \
  -o persist_windows=no \
  -o background=#000000 \
  -o background_opacity=1 \
  -o tab_bar_style=hidden \
  -o cursor_blink_interval=0 \
  -o enable_audio_bell=no \
  screensaver --run
