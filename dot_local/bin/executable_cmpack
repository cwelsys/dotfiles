#!/usr/bin/env bash

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
MAGENTA='\033[0;35m'
CYAN='\033[0;36m'
DIM='\033[2m'
BOLD='\033[1m'
RESET='\033[0m'

log_info() { echo -e "${CYAN}→${RESET} $1"; }
log_success() { echo -e "${GREEN}✓${RESET} $1"; }
log_error() { echo -e "${RED}✗${RESET} $1" >&2; }
log_warn() { echo -e "${YELLOW}!${RESET} $1"; }

OS=$(uname -s | tr '[:upper:]' '[:lower:]')

DATA_DIR="${DOTS:-$HOME/.local/share/chezmoi}/.chezmoidata"
HOSTS_DIR="$DATA_DIR/hosts"

# --- Merged view ---

MERGED_FILE=""
MERGED_IS_FIXTURE=0
cleanup() {
  [[ -n "$MERGED_FILE" && "$MERGED_IS_FIXTURE" -eq 0 ]] && rm -f "$MERGED_FILE"
  return 0
}
trap cleanup EXIT

_ensure_merged() {
  [[ -n "$MERGED_FILE" ]] && return 0
  if [[ -n "${CMPACK_DATA_FILE:-}" ]]; then
    MERGED_FILE="$CMPACK_DATA_FILE"
    MERGED_IS_FIXTURE=1
  else
    MERGED_FILE=$(mktemp)
    chezmoi data --format=json ${DOTS:+--source="$DOTS"} >"$MERGED_FILE"
  fi
}

_ensure_merged

FLATTEN='if type=="object" then ([.[]] | add // []) else . end
       | .[] | if type=="object" then .name else . end'

jq_data() {
  _ensure_merged
  jq "$@" "$MERGED_FILE"
}

HOSTNAME=$(jq_data -r '.hostname')
HOST_FILE="$HOSTS_DIR/$HOSTNAME.yml"

# --- Section registry ---

section_meta() {
  case "$1" in
  pacman) printf '󰮯\t%s\tpacman\t1\n' "$YELLOW" ;;
  brews) printf '\t%s\tbrew\t1\n' "$YELLOW" ;;
  casks) printf '\t%s\tcask\t1\n' "$YELLOW" ;;
  cargo) printf '🦀\t%s\tcargo\t0\n' "$RESET" ;;
  npm) printf '\t%s\tnpm\t0\n' "$RED" ;;
  pipx) printf '\t%s\tpipx\t0\n' "$YELLOW" ;;
  go) printf '\t%s\tgo\t0\n' "$CYAN" ;;
  yazi) printf '󰇥\t%s\tyazi\t0\n' "$MAGENTA" ;;
  *) return 1 ;;
  esac
}


# --- Section discovery ---

system_sections() {
  case "$OS" in
  darwin) echo "brews casks" ;;
  linux) [[ -f /etc/arch-release ]] && echo "pacman" ;;
  esac
}

universal_sections() {
  local sections=""
  command -v cargo &>/dev/null && sections+="cargo "
  command -v npm &>/dev/null && sections+="npm "
  command -v pipx &>/dev/null && sections+="pipx "
  command -v go &>/dev/null && sections+="go "
  command -v ya &>/dev/null && sections+="yazi "
  echo "$sections"
}

all_sections() { echo "$(system_sections) $(universal_sections)"; }

# --- YAML helpers ---

manifest_packages() {
  local host="$1" section="$2"
  {
    jq_data -r "(.pkgs.$section // []) | $FLATTEN"
    jq_data -r "(.hosts.\"$host\".pkgs.$section // []) | $FLATTEN"
  } | sort -u
}

# --- Package detection ---

_pacman_sl() { if [[ -n "${CMPACK_PACMAN_SL:-}" ]]; then cat "$CMPACK_PACMAN_SL"; else pacman -Sl; fi; }
_pacman_qeq() { if [[ -n "${CMPACK_PACMAN_QEQ:-}" ]]; then cat "$CMPACK_PACMAN_QEQ"; else pacman -Qeq; fi; }

installed_buckets() {
  case "$1" in
  pacman)
    local repomap
    repomap=$(mktemp)
    _pacman_sl | awk '/\[installed/{print $2"\t"$1}' | sort -k1,1 >"$repomap"
    join -t$'\t' -a1 -e aur -o '0,2.2' <(_pacman_qeq | sort) "$repomap"
    rm -f "$repomap"
    ;;
  brews)
    brew info --json=v2 --installed |
      jq -r '.formulae[] | select(.installed_on_request) | "\(.name)\t\(.tap)"' | sort -k1,1
    ;;
  casks)
    brew info --json=v2 --installed |
      jq -r '.casks[] | "\(.token)\t\(.tap)"' | sort -k1,1
    ;;
  esac
}

package_present() {
  case "$1" in
  pacman) pacman -Qq "$2" &>/dev/null ;;
  brews) brew list --formula "$2" &>/dev/null ;;
  casks) brew list --cask "$2" &>/dev/null ;;
  *) return 1 ;;
  esac
}

installed_packages() {
  local section="$1" glyph color label grouped
  IFS=$'\t' read -r glyph color label grouped < <(section_meta "$section") || return 1
  if [[ "$grouped" == "1" ]]; then
    installed_buckets "$section" | cut -f1 | sort
    return
  fi
  case "$section" in
  cargo) cargo install --list 2>/dev/null | grep -E '^\w' | awk '{print $1}' | sort ;;
  npm) npm list -g --depth=0 --json 2>/dev/null | jq -r '.dependencies // {} | keys[]' | sort ;;
  pipx) pipx list --short 2>/dev/null | awk '{print $1}' | sort ;;
  go)
    local gobin="${GOBIN:-$HOME/go/bin}" bin
    for bin in "$gobin"/*; do
      [[ -x "$bin" ]] || continue
      go version -m "$bin" 2>/dev/null | awk -F'\t' '$2=="path"{print $3; exit}'
    done | sort
    ;;
  yazi) ya pkg list 2>/dev/null | awk '/^\t/{print $1}' | sort ;;
  esac
}

cargo_git_url() {
  cargo install --list 2>/dev/null |
    grep -E "^$1 " |
    grep -oE '\(https?://[^#) ]+' |
    head -1 | sed 's/^(//'
}

# --- Commands ---

host_exists() { jq_data -e --arg h "$1" '.hosts | has($h)' >/dev/null 2>&1; }

cmd_list() {
  local section n glyph color label grouped

  echo -e "${BOLD}Global tier:${RESET}"
  while IFS=$'\t' read -r section n; do
    IFS=$'\t' read -r glyph color label grouped < <(section_meta "$section") || continue
    echo -e "  ${color}${glyph}${RESET} ${label}: ${YELLOW}${n} pkgs${RESET}"
  done < <(jq_data -r "(.pkgs // {}) | to_entries[] | [.key, (.value | length)] | @tsv")

  echo -e "\n${BOLD}Hosts:${RESET}\n"
  local host total sections types marker
  while IFS=$'\t' read -r host total sections; do
    types=""
    for section in $sections; do
      IFS=$'\t' read -r glyph color label grouped < <(section_meta "$section") || continue
      types+="${color}${glyph}${RESET} "
    done
    marker=""
    [[ "$host" == "$HOSTNAME" ]] && marker=" ${GREEN}(current)${RESET}"
    printf "  ${CYAN}%-20s${RESET} ${DIM}%b${RESET} ${YELLOW}%d pkgs${RESET}%b\n" \
      "$host" "$types" "$total" "$marker"
  done < <(jq_data -r "
    .hosts | to_entries[] | .key as \$h | (.value.pkgs // {}) as \$p
    | [\$h,
       (\$p | [to_entries[] | (.value | [$FLATTEN] | length)] | add // 0),
       (\$p | keys | join(\" \"))] | @tsv")
}

cmd_show() {
  local target="$1"
  if ! host_exists "$target"; then
    log_error "Host '$target' not found"
    return 1
  fi

  echo -e "${BOLD}Packages for $target:${RESET}"
  local section bucket pkg glyph color label grouped last_s="" last_b=""
  while IFS=$'\t' read -r section bucket pkg; do
    if [[ "$section" != "$last_s" || "$bucket" != "$last_b" ]]; then
      IFS=$'\t' read -r glyph color label grouped < <(section_meta "$section") || continue
      if [[ "$bucket" != "-" ]]; then
        echo -e "\n  ${color}${glyph}${RESET} ${GREEN}${label}${RESET} ${DIM}${bucket}:${RESET}"
      else
        echo -e "\n  ${color}${glyph}${RESET} ${GREEN}${label}:${RESET}"
      fi
      last_s="$section"
      last_b="$bucket"
    fi
    echo "    $pkg"
  done < <(jq_data -r --arg h "$target" '
    (.hosts[$h].pkgs // {}) | to_entries[] | .key as $s
    | if (.value | type) == "object"
      then (.value | to_entries[] | .key as $b | .value[] | [$s, $b, (if type=="object" then .name else . end)])
      else (.value[] | [$s, "-", (if type=="object" then .name else . end)])
      end | @tsv')
}

cmd_diff() {
  local target="$1"
  if ! host_exists "$target"; then
    log_error "Host '$target' not found"
    return 1
  fi

  echo -e "${BOLD}$HOSTNAME vs $target:${RESET}"
  local section mine theirs only_mine only_theirs glyph color label grouped p
  for section in $(jq_data -r '[.hosts[].pkgs // {} | keys[]] | unique | .[]'); do
    IFS=$'\t' read -r glyph color label grouped < <(section_meta "$section") || continue
    mine=$(manifest_packages "$HOSTNAME" "$section")
    theirs=$(manifest_packages "$target" "$section")
    only_mine=$(comm -23 <(echo "$mine") <(echo "$theirs"))
    only_theirs=$(comm -13 <(echo "$mine") <(echo "$theirs"))
    [[ -z "$only_mine" && -z "$only_theirs" ]] && continue
    echo -e "\n  ${color}${glyph}${RESET} ${BOLD}${label}:${RESET}"
    [[ -n "$only_mine" ]] && while IFS= read -r p; do echo -e "    ${GREEN}+ $p${RESET}"; done <<<"$only_mine"
    [[ -n "$only_theirs" ]] && while IFS= read -r p; do echo -e "    ${RED}- $p${RESET}"; done <<<"$only_theirs"
  done
}

ensure_brew_in_path() {
  if ! command -v brew &>/dev/null; then
    if [[ -x "/opt/homebrew/bin/brew" ]]; then
      log_warn "Homebrew not in PATH. Run: eval \"\$(/opt/homebrew/bin/brew shellenv)\""
    elif [[ -x "/usr/local/bin/brew" ]]; then
      log_warn "Homebrew not in PATH. Run: eval \"\$(/usr/local/bin/brew shellenv)\""
    else
      log_error "Homebrew not installed"
    fi
    exit 1
  fi
}

# --- Sync ---

sync_section() {
  local section="$1" glyph color label grouped
  IFS=$'\t' read -r glyph color label grouped < <(section_meta "$section") || return 1

  local prefix=".hosts.\"$HOSTNAME\".pkgs.$section"
  local buckets="" installed manifest new_pkgs gone_pkgs

  if [[ "$grouped" == "1" ]]; then
    buckets=$(mktemp)
    installed_buckets "$section" >"$buckets"
    installed=$(cut -f1 "$buckets" | sort)
  else
    installed=$(installed_packages "$section")
  fi
  manifest=$(manifest_packages "$HOSTNAME" "$section")

  new_pkgs=$(comm -23 <(echo "$installed") <(echo "$manifest"))
  gone_pkgs=$(comm -13 <(echo "$installed") <(echo "$manifest"))

  local n_add=0 n_del=0 n_move=0 p b cur url

  if [[ -n "$new_pkgs" ]]; then
    n_add=$(echo "$new_pkgs" | wc -l | tr -d ' ')
    echo -e "${color}${glyph}${RESET} ${n_add} new ${label} packages"
    while IFS= read -r p; do
      echo -e "  ${GREEN}+${RESET} $p"
      printf '%s\t+\t%s\n' "$section" "$p" >>"$DETAIL"
      if [[ "$grouped" == "1" ]]; then
        b=$(awk -F'\t' -v n="$p" '$1==n{print $2; exit}' "$buckets")
        yq -i "${prefix}.${b:-aur} += [\"$p\"]" "$HOST_FILE"
      elif [[ "$section" == "cargo" ]]; then
        url=$(cargo_git_url "$p")
        if [[ -n "$url" ]]; then
          yq -i "${prefix} += [{\"name\": \"$p\", \"git\": \"$url\"}]" "$HOST_FILE"
        else
          yq -i "${prefix} += [\"$p\"]" "$HOST_FILE"
        fi
      else
        yq -i "${prefix} += [\"$p\"]" "$HOST_FILE"
      fi
    done <<<"$new_pkgs"
  fi

  if [[ -n "$gone_pkgs" ]]; then
    while IFS= read -r p; do
      if ! jq_data -e --arg p "$p" \
        "(.hosts.\"$HOSTNAME\".pkgs.$section // []) | $FLATTEN | select(. == \$p)" >/dev/null 2>&1; then
        package_present "$section" "$p" && continue
        log_warn "$p is in the global tier but not installed here — 'chezmoi apply' installs it; drop it from pkgs.yml if this host shouldn't have it"
        continue
      fi
      n_del=$((n_del + 1))
      echo -e "  ${RED}-${RESET} $p"
      printf '%s\t-\t%s\n' "$section" "$p" >>"$DETAIL"
      if [[ "$grouped" == "1" ]]; then
        yq -i "del(${prefix}[][] | select(. == \"$p\"))" "$HOST_FILE"
      else
        yq -i "del(${prefix}[] | select((.name // .) == \"$p\"))" "$HOST_FILE"
      fi
    done <<<"$gone_pkgs"
    [[ "$n_del" -gt 0 ]] && echo -e "${color}${glyph}${RESET} ${n_del} removed ${label} packages"
  fi

  if [[ "$grouped" == "1" ]]; then
    while IFS=$'\t' read -r p b; do
      cur=$(yq -r "${prefix} | to_entries[] | select(.value | any_c(. == \"$p\")) | .key" "$HOST_FILE" 2>/dev/null | head -1)
      [[ -z "$cur" || "$cur" == "null" || "$cur" == "$b" ]] && continue
      n_move=$((n_move + 1))
      echo -e "  ${YELLOW}~${RESET} $p  ${DIM}${cur} → ${b}${RESET}"
      printf '%s\t~\t%s (%s → %s)\n' "$section" "$p" "$cur" "$b" >>"$DETAIL"
      yq -i "del(${prefix}.${cur}[] | select(. == \"$p\")) | ${prefix}.${b} += [\"$p\"]" "$HOST_FILE"
    done <"$buckets"
    [[ "$n_move" -gt 0 ]] && echo -e "${color}${glyph}${RESET} ${n_move} moved ${label} packages"
  fi

  [[ -n "$buckets" ]] && rm -f "$buckets"

  if [[ "$n_add" -gt 0 || "$n_del" -gt 0 || "$n_move" -gt 0 ]]; then
    printf '%s\t%d\t%d\t%d\n' "$section" "$n_add" "$n_del" "$n_move" >>"$SUMMARY"
    if [[ "$grouped" == "1" ]]; then
      yq -i "${prefix} |= map_values(sort) | del(${prefix}[] | select(length == 0))" "$HOST_FILE"
    else
      yq -i "${prefix} |= sort_by(.name // .)" "$HOST_FILE"
    fi
    return 0
  fi
  return 1
}

commit_subject() {
  local section a d m glyph color label grouped parts=() part
  while IFS=$'\t' read -r section a d m; do
    IFS=$'\t' read -r glyph color label grouped < <(section_meta "$section") || continue
    part="$glyph"
    [[ "$a" -gt 0 ]] && part+=" +$a"
    [[ "$d" -gt 0 ]] && part+=" -$d"
    [[ "$m" -gt 0 ]] && part+=" ~$m"
    parts+=("$part")
  done <"$SUMMARY"
  if [[ ${#parts[@]} -eq 0 ]]; then
    echo "[pkg]: refresh $HOSTNAME"
  else
    local joined=""
    for part in "${parts[@]}"; do
      [[ -n "$joined" ]] && joined+=", "
      joined+="$part"
    done
    echo "[pkg]: $joined"
  fi
}

commit_body() {
  local section op pkg glyph color label grouped last=""
  while IFS=$'\t' read -r section op pkg; do
    if [[ "$section" != "$last" ]]; then
      [[ -n "$last" ]] && echo
      IFS=$'\t' read -r glyph color label grouped < <(section_meta "$section") || continue
      echo "$glyph $section"
      last="$section"
    fi
    echo "  $op $pkg"
  done <"$DETAIL"
}

commit_changes() {
  local src tracked
  src="${DOTS:-$(chezmoi source-path)}"
  tracked=".chezmoidata/hosts/$HOSTNAME.yml"
  git -C "$src" add -- "$tracked" 2>/dev/null || true
  if git -C "$src" diff --cached --quiet -- "$tracked"; then
    log_info "No yml changes to commit"
    return
  fi
  git -C "$src" commit -m "$(commit_subject)" -m "$(commit_body)" || log_warn "git commit failed"
}

cmd_sync() {
  [[ "$(system_sections)" == *brew* ]] && ensure_brew_in_path

  if [[ ! -f "$HOST_FILE" ]]; then
    log_error "Host '$HOSTNAME' not registered: $HOST_FILE"
    log_info "Run 'chezmoi apply' to register this machine"
    exit 1
  fi

  SUMMARY=$(mktemp)
  DETAIL=$(mktemp)
  trap 'cleanup; rm -f "$SUMMARY" "$DETAIL"' EXIT

  local section changed=1
  for section in $(all_sections); do
    if sync_section "$section"; then changed=0; fi
  done

  if [[ "$changed" -eq 0 ]]; then
    commit_changes
  else
    log_success "Up to date"
  fi
}

# --- Main ---

usage() {
  cat <<EOF
$(echo -e "${BOLD}cmpack${RESET} - chezmoi package manifest sync")

$(echo -e "${BOLD}Usage:${RESET}")
  cmpack                          Sync installed packages into this host's record
  cmpack -l, --list               List the fleet
  cmpack -s, --show HOST          Show packages for a host
  cmpack -d, --diff HOST          Compare current host with another
EOF
  exit 0
}

main() {
  set -eo pipefail
  local MODE="sync" TARGET_HOST=""

  while [[ $# -gt 0 ]]; do
    case $1 in
    -l | --list)
      MODE="list"
      shift
      ;;
    -s | --show)
      MODE="show"
      TARGET_HOST="$2"
      shift 2
      ;;
    -d | --diff)
      MODE="diff"
      TARGET_HOST="$2"
      shift 2
      ;;
      -h | --help) usage ;;
    *)
      log_error "Unknown option: $1"
      usage
      ;;
    esac
  done

  if [[ "$MODE" =~ ^(show|diff)$ && -z "$TARGET_HOST" ]]; then
    log_error "--${MODE} requires a hostname"
    usage
  fi

  case "$MODE" in
  list) cmd_list ;;
  show) cmd_show "$TARGET_HOST" ;;
  diff) cmd_diff "$TARGET_HOST" ;;
  sync) cmd_sync ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
