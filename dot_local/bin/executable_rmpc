#!/bin/sh

case "$0" in
    */*) self_dir=${0%/*} ;;
    *) self_dir=. ;;
esac

real_rmpc() {
    old_ifs=$IFS
    IFS=:
    for dir in $PATH; do
        [ -n "$dir" ] || continue
        [ -x "$dir/rmpc" ] || continue
        [ "$dir/rmpc" -ef "$0" ] && continue
        IFS=$old_ifs
        printf '%s\n' "$dir/rmpc"
        return 0
    done
    IFS=$old_ifs
    return 1
}

rmpc_bin=$(real_rmpc) || {
    echo "rmpc: real rmpc not found on PATH" >&2
    exit 127
}

has_subcommand=0
skip_next=0
for arg in "$@"; do
    if [ "$skip_next" -eq 1 ]; then
        skip_next=0
        continue
    fi
    case "$arg" in
        -a|--address|--address=*) exec "$rmpc_bin" "$@" ;;
        -c|--config|-t|--theme|-p|--password|--partition) skip_next=1 ;;
        -*) ;;
        *) has_subcommand=1 ;;
    esac
done

case " $* " in
    *" -V "*|*" --version "*|*" -v "*|*" -h "*|*" --help "*) exec "$rmpc_bin" "$@" ;;
esac

target=$("$self_dir/mpd-active")

if [ "$has_subcommand" -eq 1 ]; then
    exec "$rmpc_bin" -a "$target" "$@"
fi

flag="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/rmpc-flip.$$"
rm -f "$flag"
RMPC_FLIP_FLAG=$flag
export RMPC_FLIP_FLAG

while :; do
    "$rmpc_bin" -a "$target" "$@"
    rc=$?
    if [ -e "$flag" ]; then
        rm -f "$flag"
        other=$("$self_dir/mpd-active" --other "$target")
        if "$self_dir/mpd-active" --reachable "$other"; then
            target=$other
        else
            echo "rmpc: $other is not reachable, staying on $target" >&2
        fi
        continue
    fi
    exit "$rc"
done
