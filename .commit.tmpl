{{- range .chezmoi.status.Unmerged }}{{ fail (printf "unmerged: %s" .Path) }}{{ end -}}
{{- range .chezmoi.status.Untracked }}{{ fail (printf "untracked: %s" .Path) }}{{ end -}}

{{- /* ===== COLLECT ===== */ -}}
{{- $entries := list -}}
{{- range .chezmoi.status.Ordinary -}}
{{-   $op := "M" -}}
{{-   if eq .X 'A' }}{{ $op = "A" }}{{ end -}}
{{-   if eq .X 'D' }}{{ $op = "D" }}{{ end -}}
{{-   $entries = append $entries (dict "op" $op "path" .Path) -}}
{{- end -}}
{{- range .chezmoi.status.RenamedOrCopied -}}
{{-   $entries = append $entries (dict "op" "R" "path" .Path) -}}
{{- end -}}

{{- /* ===== SCOPE + RELATIVE NAME ===== */ -}}
{{- $items := list -}}
{{- range $entries -}}
{{-   $path := .path -}}
{{-   if not (hasPrefix "." $path) }}{{ $path = $path | targetRelPath }}{{ end -}}
{{-   $segs := splitList "/" $path -}}
{{-   $scope := "root" -}}
{{-   $rel := $path -}}
{{-   if gt (len $segs) 1 -}}
{{-     $head := index $segs 0 -}}
{{-     if and (or (eq $head ".config") (eq $head ".local")) (gt (len $segs) 2) -}}
{{-       $scope = index $segs 1 -}}
{{-       $rel = join "/" (rest (rest $segs)) -}}
{{-     else -}}
{{-       $scope = trimPrefix "." $head -}}
{{-       $rel = join "/" (rest $segs) -}}
{{-     end -}}
{{-   end -}}
{{-   $items = append $items (dict "op" .op "scope" $scope "rel" $rel) -}}
{{- end -}}

{{- /* ===== TYPE + VERB ===== */ -}}
{{- $ops := list -}}{{ range $items }}{{ $ops = append $ops .op }}{{ end -}}
{{- $uniqOps := $ops | uniq -}}
{{- $verb := "change" -}}
{{- $ctype := "chore" -}}
{{- if eq (len $uniqOps) 1 -}}
{{-   $op := index $uniqOps 0 -}}
{{-   if eq $op "M" }}{{ $verb = "update" }}{{ end -}}
{{-   if eq $op "A" }}{{ $verb = "add" }}{{ $ctype = "feat" }}{{ end -}}
{{-   if eq $op "D" }}{{ $verb = "delete" }}{{ end -}}
{{-   if eq $op "R" }}{{ $verb = "rename" }}{{ end -}}
{{- end -}}

{{- /* ===== SCOPE LABEL ===== */ -}}
{{- $scopes := list -}}{{ range $items }}{{ $scopes = append $scopes .scope }}{{ end -}}
{{- $uniqScopes := $scopes | uniq | sortAlpha -}}
{{- $named := without $uniqScopes "root" -}}
{{- $label := "" -}}
{{- if eq (len $named) 1 -}}
{{-   $label = printf "(%s)" (index $named 0) -}}
{{- else if and (gt (len $named) 1) (le (len $named) 3) -}}
{{-   $label = printf "(%s)" (join "," $named) -}}
{{- else if gt (len $named) 3 -}}
{{-   $label = printf "(%s,+%d)" (join "," (slice $named 0 2)) (sub (len $named) 2) -}}
{{- end -}}

{{- /* ===== SUBJECT ===== */ -}}
{{- $n := len $items -}}
{{- $names := list -}}{{ range $items }}{{ $names = append $names .rel }}{{ end -}}
{{- $listed := join ", " $names -}}
{{- $head := printf "%s%s: %s " $ctype $label $verb -}}
{{- if and (le $n 3) (le (add (len $head) (len $listed)) 72) -}}
{{ $head }}{{ $listed }}
{{- else -}}
{{ $head }}{{ $n }} files
{{- end -}}
